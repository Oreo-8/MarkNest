{
  "manifest_version": 3,
  "name": "MarkNest - 本地 Markdown 阅读与编辑器",
  "short_name": "MarkNest",
  "version": "2.3.0",
  "description": "在浏览器中预览、编辑和保存本地 Markdown 文件，并一键收录 AI 对话。",
  "permissions": ["storage", "activeTab", "scripting", "downloads"],
  "host_permissions": [
    "file:///*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://qianwen.com/*",
    "https://www.qianwen.com/*",
    "https://tongyi.aliyun.com/*",
    "https://chat.qwen.ai/*",
    "https://grok.com/*",
    "https://www.grok.com/*",
    "https://doubao.com/*",
    "https://www.doubao.com/*",
    "https://kimi.com/*",
    "https://www.kimi.com/*",
    "https://kimi.moonshot.cn/*",
    "https://chatglm.cn/*",
    "https://www.chatglm.cn/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "打开 MarkNest",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [
    {
      "resources": ["file-app.js", "assets/*.js", "assets/*.woff", "assets/*.woff2", "assets/*.ttf"],
      "matches": ["file:///*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["file:///*.md", "file:///*.markdown"],
      "css": ["file-viewer.css"],
      "js": ["file-viewer.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-editor": {
      "suggested_key": { "default": "Ctrl+Shift+M", "mac": "Command+Shift+M" },
      "description": "打开 MarkNest"
    }
  }
}
